# ============================================================
# Archivo de ejemplo de variables de entorno.
# COPIAR este archivo como .env y completar con valores reales.
# NUNCA subir el archivo .env al control de versiones.
# ============================================================

# Entorno de ejecucion: development | production
DJANGO_ENVIRONMENT=development

# Clave secreta de Django. Generar con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-clave-secreta-por-una-real

# DEBUG solo debe ser True en desarrollo
DEBUG=True

# Hosts permitidos separados por coma (solo relevante en produccion)
ALLOWED_HOSTS=localhost,127.0.0.1

# Origenes de confianza para CSRF en produccion (incluir protocolo y dominio)
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com

# ============================================================
# Base de datos PostgreSQL
# ============================================================
DB_NAME=gestion_academica
DB_USER=postgres
DB_PASSWORD=tu_contrasena_segura
DB_HOST=localhost
DB_PORT=5432

# ============================================================
# CORS: Origenes permitidos para consumir la API
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
